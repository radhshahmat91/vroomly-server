# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (use the SAME database as the Next.js app) ──
MONGODB_URI=mongodb://127.0.0.1:27017/vroomly
MONGODB_DB=vroomly
# If your network refuses Atlas SRV lookups ("querySrv ECONNREFUSED") the API resolves the address over HTTPS automatically.
# Run `npm run check-db` to diagnose connection problems. Optional: also point Node at public DNS:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Web client(s) allowed to call this API (comma separated, no trailing slash) ──
CLIENT_URL=http://localhost:3000

# ── BetterAuth (runs inside the Next.js app). The API verifies its JWTs via the JWKS endpoint. ──
AUTH_URL=http://localhost:3000
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

# ── Stripe (test mode) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Local-only escape hatch: lets you click through checkout without Stripe keys. Ignored in production.
DEMO_PAYMENTS=false

# ── Cloudinary (image uploads) ────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Marketplace ───────────────────────────────────────
# Share of every booking kept by Vroomly (0.10 = 10%). Hosts earn the rest.
PLATFORM_COMMISSION=0.10
