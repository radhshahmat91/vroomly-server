{
  "name": "vroomly-server",
  "version": "1.0.0",
  "description": "Vroomly REST API \u2014 peer-to-peer car rental marketplace (Express, MongoDB, Socket.IO, Stripe)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node src/seed/seed.js",
    "seed:destroy": "node src/seed/seed.js --destroy",
    "make-admin": "node src/seed/makeAdmin.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "check-db": "node src/seed/checkDb.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mongoose": "^8.24.8",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
